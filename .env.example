# Predict Market Maker Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# Environment: testnet or mainnet
PMM_ENVIRONMENT=testnet

# Predict API Key (optional but recommended for mainnet)
# PMM_PREDICT_API_KEY=your-api-key-here

# Wallet private key for signing transactions
# WARNING: Keep this secret! Never share or commit!
# PMM_WALLET_PRIVATE_KEY=your-private-key-here

# Wallet address (optional, can be derived from private key)
# PMM_WALLET_ADDRESS=0x...

# Market allowlist (comma-separated)
# PMM_MARKET_ALLOWLIST=market-id-1,market-id-2

# Database path (default: market_maker.db)
# PMM_DATABASE_PATH=market_maker.db
